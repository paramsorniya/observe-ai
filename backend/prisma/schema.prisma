generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum ProjectMemberRole {
  OWNER
  ADMIN
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum UserStatus {
  ghost
  integrated
  active
  dormant
  churned
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String?
  isAdmin              Boolean            @default(false)
  isBanned             Boolean            @default(false)
  bannedAt             DateTime?
  bannedReason         String?
  subscriptionTier     SubscriptionTier   @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(active)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  userStatus           UserStatus         @default(ghost)
  firstApiCallAt       DateTime?
  lastApiCallAt        DateTime?
  totalApiCallsLifetime Int               @default(0)
  apiCallsThisMonth    Int                @default(0)
  freeLimitHitCount    Int                @default(0)
  planStartedAt        DateTime           @default(now())
  integrationCompletedAt DateTime?
  referralSource       String?
  monthlyRequestCount  Int                @default(0)
  monthlyRequestLimit  Int                @default(10000)
  requestResetDate     DateTime           @default(now())
  projectLimit         Int                @default(1)
  pendingDowngrade     Boolean            @default(false)
  downgradeDate        DateTime?
  downgradeTo          SubscriptionTier?
  projectsToKeep       Json?
  currentPeriodEnd     DateTime?
  paymentFailedAt      DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lastActiveAt         DateTime           @default(now())

  projects            Project[]
  subscriptionHistory SubscriptionHistory[]
  invoices            Invoice[]
  auditLogs           AuditLog[]
  tags                UserTag[]
  projectMemberships  ProjectMember[]
  sentInvitations     ProjectInvitation[] @relation("SentInvitations")
  enterpriseContacts  EnterpriseContact[]
  enterpriseConfig    EnterpriseConfig?

  @@index([subscriptionTier])
  @@index([stripeCustomerId])
  @@index([userStatus])
  @@index([lastApiCallAt])
  @@index([planStartedAt])
  @@index([firstApiCallAt])
  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests    Request[]
  members     ProjectMember[]
  invitations ProjectInvitation[]

  @@index([userId])
  @@index([apiKey])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole @default(VIEWER)
  joinedAt  DateTime          @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvitation {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedEmail String
  invitedById  String
  invitedBy    User              @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  role         ProjectMemberRole @default(VIEWER)
  token        String            @unique @default(cuid())
  status       InvitationStatus  @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([projectId])
  @@index([token])
  @@index([invitedEmail])
  @@map("project_invitations")
}

model Request {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp        DateTime @default(now())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  totalCost        Decimal  @db.Decimal(10, 6)
  latencyMs        Int      @default(0)
  status           String   @default("success")
  errorMessage     String?  @db.Text
  errorType        String?
  prompt           String?  @db.Text
  response         String?  @db.Text
  userId           String?
  sessionId        String?
  endpoint         String?
  tags             String[] @default([])

  toolCalls ToolCall[]

  @@index([projectId, timestamp(sort: Desc)])
  @@index([status])
  @@index([provider, model])
  @@index([timestamp(sort: Desc)])
  @@index([sessionId])
  @@map("requests")
}

model ToolCall {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  timestamp    DateTime @default(now())
  toolName     String
  toolInput    String?  @db.Text
  toolOutput   String?  @db.Text
  latencyMs    Int?
  status       String   @default("called")
  errorMessage String?

  @@index([requestId])
  @@index([toolName])
  @@map("tool_calls")
}

model SubscriptionHistory {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  oldTier   SubscriptionTier?
  newTier   SubscriptionTier?
  reason    String?
  metadata  Json?
  timestamp DateTime          @default(now())

  @@index([userId])
  @@map("subscription_history")
}

model Invoice {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId       String    @unique
  stripePaymentIntentId String?
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("usd")
  status                String
  paidAt                DateTime?
  dueDate               DateTime?
  invoiceUrl            String?
  invoicePdf            String?
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@map("invoices")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([tag])
  @@map("user_tags")
}

model EnterpriseContact {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  company       String
  role          String
  useCase       String
  monthlyVolume String
  phone         String?
  status        String   @default("new")
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("enterprise_contacts")
}

model EnterpriseConfig {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRequestLimit  Int       @default(999999999)
  customRetentionDays Int       @default(365)
  customTeamMembers   Int       @default(999)
  monthlyPrice        Int       @default(0)
  contractStart       DateTime  @default(now())
  contractEnd         DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("enterprise_configs")
}
